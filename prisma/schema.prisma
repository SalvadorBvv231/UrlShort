// Esquema de Prisma para Recorta.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Link {
  id        String   @id @default(cuid())
  code      String   @unique
  url       String
  clicks    Int      @default(0)
  ownerId   String
  createdAt DateTime @default(now())

  @@index([ownerId])
}
